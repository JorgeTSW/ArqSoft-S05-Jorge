<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!--AGREGA ESTA LÍNEA PARA PERMITIR LA COMPILACIÓN SIN INTERRUPCIONES DE ADVERTENCIAS -->
		<NoWarn>$(NoWarn);NU1903</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.OpenApi" Version="3.8.0" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="CitasApp.Application\CitasApp.Application.csproj" />
		<ProjectReference Include="CitasApp.Domain\CitasApp.Domain.csproj" />
		<ProjectReference Include="CitasApp.Infrastructure\CitasApp.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="CitasApp.Api\**" />
		<Compile Remove="CitasApp.Application\**" />
		<Compile Remove="CitasApp.Domain\**" />
		<Compile Remove="CitasApp.Infrastructure\**" />
		<Compile Remove="CitasApp.xUnit\**" />

		<Content Remove="CitasApp.Api\**" />
		<Content Remove="CitasApp.Application\**" />
		<Content Remove="CitasApp.Domain\**" />
		<Content Remove="CitasApp.Infrastructure\**" />
		<Content Remove="CitasApp.xUnit\**" />

		<None Remove="CitasApp.Api\**" />
		<None Remove="CitasApp.Application\**" />
		<None Remove="CitasApp.Domain\**" />
		<None Remove="CitasApp.Infrastructure\**" />
		<None Remove="CitasApp.xUnit\**" />
	</ItemGroup>
</Project>